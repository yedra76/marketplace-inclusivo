# Dependencias
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Entornos virtuales y variables de entorno
.env
.env.local
.env.production
.env.development
*.env

# Archivos de configuración específicos de cada servicio
# (cada microservicio puede tener su propio .env)
servicios/*/.env
servicios/*/node_modules/

# Docker
*.log
Dockerfile*
docker-compose.override.yml
.docker/
*.pid
*.seed
*.pid.lock

# Base de datos (si tienes volúmenes locales)
/data/
/postgres-data/
/redis-data/
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Tests y cobertura
coverage/
*.lcov
.nyc_output/

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Archivos temporales
tmp/
temp/
*.tmp
*.temp

# Reportes (opcional - si no quieres versionar los reportes)
# reports/
# pero como ya tienes reports/estado-proyecto.md, mejor NO ignorarlo

# Archivos de secreto (MUY IMPORTANTE)
**/secrets/
**/keys/
*.pem
*.key
*.crt

# Archivos de backup
*.bak
*.backup